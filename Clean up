import React, { useState, useEffect, useRef } from 'react';
import { Sparkles, Volume2, VolumeX, Trophy, Star } from 'lucide-react';

const ZenOrganizeGame = () => {
  const [currentLevel, setCurrentLevel] = useState(1);
  const [score, setScore] = useState(0);
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [showLevelComplete, setShowLevelComplete] = useState(false);
  const audioContextRef = useRef(null);

  useEffect(() => {
    audioContextRef.current = new (window.AudioContext || window.webkitAudioContext)();
    return () => {
      if (audioContextRef.current) {
        audioContextRef.current.close();
      }
    };
  }, []);

  const playSound = (frequency, duration = 0.1) => {
    if (!soundEnabled || !audioContextRef.current) return;
    
    const ctx = audioContextRef.current;
    const oscillator = ctx.createOscillator();
    const gainNode = ctx.createGain();
    
    oscillator.connect(gainNode);
    gainNode.connect(ctx.destination);
    
    oscillator.frequency.value = frequency;
    oscillator.type = 'sine';
    
    gainNode.gain.setValueAtTime(0.2, ctx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
    
    oscillator.start(ctx.currentTime);
    oscillator.stop(ctx.currentTime + duration);
  };

  const handleLevelComplete = () => {
    setShowLevelComplete(true);
    setScore(score + currentLevel * 10);
    [523, 659, 784, 880].forEach((freq, i) => {
      setTimeout(() => playSound(freq, 0.2), i * 80);
    });
  };

  const nextLevel = () => {
    setCurrentLevel(currentLevel + 1);
    setShowLevelComplete(false);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 flex items-center justify-center p-4">
      <div className="w-full max-w-2xl">
        {/* Clean Header */}
        <div className="bg-white/80 backdrop-blur rounded-t-3xl p-6 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-lg">
              <Sparkles className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-gray-800">Sort It</h1>
              <p className="text-sm text-gray-500">Level {currentLevel}</p>
            </div>
          </div>
          
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 bg-gradient-to-r from-yellow-400 to-orange-400 text-white px-4 py-2 rounded-full font-bold shadow-lg">
              <Star className="w-4 h-4" fill="white" />
              {score}
            </div>
            <button
              onClick={() => setSoundEnabled(!soundEnabled)}
              className="w-10 h-10 hover:bg-gray-100 rounded-full transition flex items-center justify-center"
            >
              {soundEnabled ? (
                <Volume2 className="w-5 h-5 text-gray-700" />
              ) : (
                <VolumeX className="w-5 h-5 text-gray-400" />
              )}
            </button>
          </div>
        </div>

        {/* Game Area */}
        <div className="bg-white/80 backdrop-blur shadow-2xl p-8 min-h-[600px] relative">
          {!showLevelComplete ? (
            <ColorSortGame 
              level={currentLevel} 
              playSound={playSound}
              onComplete={handleLevelComplete}
            />
          ) : (
            <LevelComplete 
              level={currentLevel}
              score={currentLevel * 10}
              onNext={nextLevel}
            />
          )}
        </div>

        <div className="bg-white/80 backdrop-blur rounded-b-3xl p-4 text-center">
          <p className="text-sm text-gray-500">Tap tubes to move colors • Match all colors to complete</p>
        </div>
      </div>
    </div>
  );
};

const ColorSortGame = ({ level, playSound, onComplete }) => {
  const [tubes, setTubes] = useState([]);
  const [selectedTube, setSelectedTube] = useState(null);
  const [moves, setMoves] = useState(0);

  // Generate level configuration
  const generateLevel = () => {
    const numColors = Math.min(3 + Math.floor((level - 1) / 2), 8);
    const tubesCount = numColors + 2;
    const colorsPerTube = Math.min(3 + Math.floor((level - 1) / 3), 5);
    
    const colorPalettes = [
      ['#FF6B9D', '#C44569', '#FFC312', '#EE5A6F'],
      ['#4A90E2', '#7B68EE', '#9B59B6', '#3498DB'],
      ['#2ECC71', '#1ABC9C', '#16A085', '#27AE60'],
      ['#E74C3C', '#C0392B', '#D35400', '#E67E22'],
      ['#F39C12', '#F1C40F', '#D4AC0D', '#F8B739'],
      ['#8E44AD', '#9B59B6', '#BB8FCE', '#A569BD'],
      ['#1ABC9C', '#16A085', '#45B7AF', '#52BE80'],
      ['#E67E22', '#D68910', '#F39C12', '#DC7633']
    ];

    const selectedColors = colorPalettes.slice(0, numColors).map(p => p[0]);
    
    // Create colored balls
    let balls = [];
    selectedColors.forEach(color => {
      for (let i = 0; i < colorsPerTube; i++) {
        balls.push(color);
      }
    });
    
    // Shuffle balls
    balls = balls.sort(() => Math.random() - 0.5);
    
    // Distribute into tubes
    const newTubes = [];
    for (let i = 0; i < numColors; i++) {
      newTubes.push(balls.splice(0, colorsPerTube));
    }
    
    // Add empty tubes
    for (let i = 0; i < tubesCount - numColors; i++) {
      newTubes.push([]);
    }
    
    return newTubes;
  };

  useEffect(() => {
    setTubes(generateLevel());
    setMoves(0);
    setSelectedTube(null);
  }, [level]);

  useEffect(() => {
    if (tubes.length > 0) {
      const isComplete = tubes.every(tube => {
        if (tube.length === 0) return true;
        return tube.every(ball => ball === tube[0]) && tube.length === Math.min(3 + Math.floor((level - 1) / 3), 5);
      });
      
      if (isComplete && moves > 0) {
        setTimeout(() => onComplete(), 500);
      }
    }
  }, [tubes]);

  const handleTubeClick = (index) => {
    if (selectedTube === null) {
      // Select tube if it has balls
      if (tubes[index].length > 0) {
        setSelectedTube(index);
        playSound(440, 0.1);
      }
    } else if (selectedTube === index) {
      // Deselect
      setSelectedTube(null);
      playSound(330, 0.1);
    } else {
      // Try to move ball
      const fromTube = tubes[selectedTube];
      const toTube = tubes[index];
      const maxCapacity = Math.min(3 + Math.floor((level - 1) / 3), 5);
      
      if (fromTube.length > 0 && toTube.length < maxCapacity) {
        const topBall = fromTube[fromTube.length - 1];
        
        // Can only place on empty tube or matching color
        if (toTube.length === 0 || toTube[toTube.length - 1] === topBall) {
          const newTubes = tubes.map(t => [...t]);
          const ball = newTubes[selectedTube].pop();
          newTubes[index].push(ball);
          setTubes(newTubes);
          setMoves(moves + 1);
          playSound(523 + toTube.length * 50, 0.12);
        } else {
          playSound(220, 0.15);
        }
      }
      setSelectedTube(null);
    }
  };

  const maxCapacity = Math.min(3 + Math.floor((level - 1) / 3), 5);

  return (
    <div className="space-y-8">
      <div className="flex justify-between items-center">
        <div className="text-gray-600">
          <span className="font-semibold text-gray-800">{moves}</span> moves
        </div>
        <button
          onClick={() => {
            setTubes(generateLevel());
            setMoves(0);
            setSelectedTube(null);
            playSound(392, 0.1);
          }}
          className="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-medium text-gray-700 transition"
        >
          Restart
        </button>
      </div>

      <div className="grid grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-4 justify-items-center">
        {tubes.map((tube, index) => (
          <button
            key={index}
            onClick={() => handleTubeClick(index)}
            className={`relative transition-all duration-200 ${
              selectedTube === index ? 'scale-110 -translate-y-2' : 'hover:scale-105'
            }`}
          >
            {/* Tube container */}
            <div className={`w-16 h-48 rounded-3xl border-4 flex flex-col-reverse p-1 gap-1 transition-all ${
              selectedTube === index 
                ? 'border-purple-500 bg-purple-50 shadow-lg' 
                : 'border-gray-300 bg-white shadow'
            }`}>
              {/* Balls */}
              {tube.map((color, ballIndex) => (
                <div
                  key={ballIndex}
                  className="w-full h-9 rounded-full shadow-sm transition-all duration-300"
                  style={{ 
                    backgroundColor: color,
                    transform: `translateY(${selectedTube === index && ballIndex === tube.length - 1 ? '-4px' : '0'})`
                  }}
                />
              ))}
              
              {/* Empty slots hint */}
              {Array.from({ length: maxCapacity - tube.length }).map((_, i) => (
                <div key={`empty-${i}`} className="w-full h-9" />
              ))}
            </div>
          </button>
        ))}
      </div>
    </div>
  );
};

const LevelComplete = ({ level, score, onNext }) => {
  return (
    <div className="flex flex-col items-center justify-center h-full space-y-6 animate-in fade-in duration-500">
      <div className="w-24 h-24 bg-gradient-to-br from-yellow-400 to-orange-400 rounded-full flex items-center justify-center shadow-2xl animate-bounce">
        <Trophy className="w-12 h-12 text-white" />
      </div>
      
      <div className="text-center space-y-2">
        <h2 className="text-4xl font-bold text-gray-800">Level {level} Complete!</h2>
        <p className="text-2xl text-purple-600 font-semibold">+{score} Stars</p>
      </div>

      <div className="flex gap-2">
        {[...Array(5)].map((_, i) => (
          <Star 
            key={i}
            className="w-8 h-8 text-yellow-400 animate-bounce"
            fill="#facc15"
            style={{ animationDelay: `${i * 0.1}s` }}
          />
        ))}
      </div>

      <button
        onClick={onNext}
        className="mt-8 px-12 py-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white text-xl font-bold rounded-full shadow-xl hover:shadow-2xl transform hover:scale-105 transition-all duration-200"
      >
        Next Level
      </button>
    </div>
  );
};

export default ZenOrganizeGame;
